#############################################
# Rule for linking CXX shared library.

rule CXX_SHARED_LIBRARY_LINKER__Diligent-GraphicsEngineVk-shared_Debug
  command = C:\WINDOWS\system32\cmd.exe /C "$PRE_LINK && "C:\Program Files\CMake\bin\cmake.exe" -E vs_link_dll --msvc-ver=1950 --intdir=$OBJECT_DIR --rc=C:\LLVM\bin\llvm-rc.exe --mt=C:\LLVM\bin\llvm-mt.exe --manifests $MANIFESTS -- C:\LLVM\bin\lld-link.exe /nologo $in  /out:$TARGET_FILE /implib:$TARGET_IMPLIB /pdb:$TARGET_PDB /dll /version:0.0 $LINK_FLAGS $LINK_PATH $LINK_LIBRARIES && $POST_BUILD"
  description = Linking CXX shared library $TARGET_FILE
  restat = $RESTAT


#############################################
