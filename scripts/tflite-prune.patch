diff --git a/tensorflow/lite/CMakeLists.txt b/tensorflow/lite/CMakeLists.txt
index cf06e2a7c8d..80503bce594 100644
--- a/tensorflow/lite/CMakeLists.txt
+++ b/tensorflow/lite/CMakeLists.txt
@@ -582,6 +582,7 @@ if (TFLITE_ENABLE_RESOURCE)
   populate_tflite_source_vars("experimental/resource"
     TFLITE_EXPERIMENTAL_RESOURCE_SRCS
   )
+  list(APPEND TFLITE_TARGET_PUBLIC_OPTIONS "-DTFLITE_ENABLE_RESOURCE=1")
 endif()
 populate_tflite_source_vars("experimental/ruy"
   TFLITE_EXPERIMENTAL_RUY_SRCS
@@ -601,6 +602,11 @@ populate_tflite_source_vars("kernels"
   TFLITE_KERNEL_SRCS
   FILTER "([^/]*_test_util_internal|test_[^/]*|[^/]*_ops_wrapper)\\.(cc|h)$"
 )
+# When TFLITE_ENABLE_RESOURCE is OFF, exclude kernels that depend on resource module
+# Note: hashtable_lookup.cc does NOT depend on resource, so we exclude it from the filter
+if(NOT TFLITE_ENABLE_RESOURCE)
+  list(FILTER TFLITE_KERNEL_SRCS EXCLUDE REGEX ".*/(hashtable|hashtable_find|hashtable_import|hashtable_size|call_once|assign_variable|read_variable|var_handle)\\.cc$")
+endif()
 populate_tflite_source_vars("kernels/internal" TFLITE_KERNEL_INTERNAL_SRCS)
 populate_tflite_source_vars("kernels/internal/optimized"
   TFLITE_KERNEL_INTERNAL_OPT_SRCS
